from __future__ import annotations

import logging
from typing import Any, Dict

logger = logging.getLogger(__name__)


def send_alert_notification(payload: Dict[str, Any]) -> None:
    """
    Simulates sending an SMTP notification email.
    Safely executes within Celery tasks without blocking worker threads.
    """
    site_id = payload.get("site_id")
    ping_results = payload.get("ping_results", {})

    print(payload)

    # Log/print simple statement confirming the client is invoked
    logger.info("The SMTP client is working! Site ID: %s", site_id)
    print(
        f"[SMTP Client] The SMTP client is working for site_id={site_id}. "
        f"Packet Loss: {ping_results.get('packet_loss_percent')}%"
    )